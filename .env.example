# ─── ChatDrill Widget ─────────────────────────────────────────────────────────
# Get your Widget ID from https://chatdrill.com → Dashboard → Widget Settings
# Prefix NEXT_PUBLIC_ makes it available in the browser bundle
NEXT_PUBLIC_CHATDRILL_WIDGET_ID=your_widget_id_here

# ─── LeadMino Lead Capture ──────────────────────────────────────────────────────
# Optional: override the default LeadMino form endpoint used by app/page.tsx
NEXT_PUBLIC_LEADMINO_FORM_ACTION=https://app.leadmino.com/f/IKE_-xgk9J7F_zod

# Optional: load your LeadMino site snippet globally (set URL from LeadMino dashboard)
NEXT_PUBLIC_LEADMINO_SNIPPET_SRC=
NEXT_PUBLIC_LEADMINO_SITE_ID=
